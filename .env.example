# Neon Postgres — projeto exclusivo da Blinko
# Use a connection string POOLED do branch `main`, database `neondb`, apenas no servidor/Vercel.
# Nunca exponha esta variável como NEXT_PUBLIC_* e nunca envie o valor em chat.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# URL pública do site, útil para e-mails e callbacks futuros.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Acesso provisório ao Blinko OS interno.
# Configure apenas no Vercel/servidor. Nunca use NEXT_PUBLIC_*.
BLINKO_INTERNAL_USER=seu-usuario-interno
BLINKO_INTERNAL_PASSWORD=use-uma-senha-forte
# Gere um segredo aleatório com pelo menos 32 caracteres.
BLINKO_INTERNAL_SESSION_SECRET=gere-um-segredo-longo-e-aleatorio

# IA Blinko
# Padrão: Vercel AI Gateway com openai/gpt-5.6-sol.
# Para testes isolados sem AI Gateway, use BLINKO_AI_PROVIDER=google somente no Preview,
# com dados fictícios, e configure GOOGLE_GENERATIVE_AI_API_KEY apenas no servidor.
BLINKO_AI_PROVIDER=gateway
BLINKO_AI_MODEL=openai/gpt-5.6-sol
BLINKO_AI_GOOGLE_MODEL=gemini-3.7-flash
GOOGLE_GENERATIVE_AI_API_KEY=sua-chave-do-google-ai-studio
